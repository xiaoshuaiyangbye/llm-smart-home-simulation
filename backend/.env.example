APP_ENV=local
LLM_MODE=mock
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a strong secret in production to require X-API-Key for every /api/ request.
API_AUTH_TOKEN=
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
REAL_LLM_API_KEY=
REAL_LLM_BASE_URL=
REAL_LLM_MODEL=
# Immutable model digest/revision (for example, an Ollama model digest). Required for version-specific experiment claims.
REAL_LLM_MODEL_REVISION=
REAL_LLM_RESOURCE_ID=
REAL_LLM_TIMEOUT_SECONDS=12
REAL_LLM_MAX_TOKENS=600
REAL_LLM_STREAM=true
# Reproducible OpenAI-compatible decoding (Ollama supports both fields).
REAL_LLM_TEMPERATURE=0.0
REAL_LLM_SEED=42
REALTIME_WEATHER_LATITUDE=
REALTIME_WEATHER_LONGITUDE=

# Local OpenAI-compatible examples:
# Ollama: REAL_LLM_BASE_URL=http://localhost:11434/v1
# LM Studio: REAL_LLM_BASE_URL=http://localhost:1234/v1
# vLLM/llama.cpp server: use the server's /v1 base URL
# Set REAL_LLM_API_KEY to any non-empty value if your local server does not check keys.
