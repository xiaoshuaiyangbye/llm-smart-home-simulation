# Local Ollama override for development. This file is loaded before backend/.env.
# Copy it to backend/.env.local and set the immutable digest reported by
# http://localhost:11434/api/tags for the model installed on your machine.
LLM_MODE=real
REAL_LLM_API_KEY=ollama
REAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
REAL_LLM_MODEL=qwen3:8b
REAL_LLM_MODEL_REVISION=sha256:<local-ollama-digest>
REAL_LLM_TIMEOUT_SECONDS=30
REAL_LLM_STREAM=false
REAL_LLM_TEMPERATURE=0.0
REAL_LLM_SEED=42
RAG_RETRIEVAL_MODE=local_embedding
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_EMBEDDING_TIMEOUT_SECONDS=30
