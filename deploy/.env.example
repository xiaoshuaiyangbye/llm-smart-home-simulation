FRONTEND_PORT=80

# Optional Docker Hub mirror prefix for networks that cannot pull directly from Docker Hub.
# Keep empty for official Docker Hub.
# Mainland China example:
# DOCKER_HUB_PREFIX=m.daocloud.io/docker.io/library/
DOCKER_HUB_PREFIX=

# Keep this empty when the frontend and API share the same origin through Nginx.
# Set it only if the browser should call a separate backend origin.
VITE_API_BASE_URL=
